NODE_ENV=development
PORT=4000
DATABASE_URL="file:./dev.db"
CORS_ORIGIN="http://127.0.0.1:7000,http://localhost:7000"
FRONTEND_URL="http://127.0.0.1:7000"
# Exact website origins allowed to embed and control uploaded Unity WebGL releases.
WEBGL_PARENT_ORIGINS="http://127.0.0.1:7000,http://localhost:7000"
BACKEND_PUBLIC_URL="http://127.0.0.1:4000"
# Optional: override public base for uploaded VRM/preview URLs (comma-separated for multiple). Defaults to BACKEND_PUBLIC_URL.
# PUBLIC_ASSET_BASE_URL="http://127.0.0.1:4000"
AUTH_COOKIE_NAME="secretwaifu_auth"
AUTH_SESSION_TTL_MS="604800000"
AUTH_EMAIL_VERIFICATION_TOKEN_TTL_MS="86400000"
AUTH_PASSWORD_RESET_TOKEN_TTL_MS="3600000"
# Password hasher used for newly created/reset passwords.
# Defaults to argon2 in production and scrypt in local/dev.
# Verification remains compatible with both formats.
# AUTH_PASSWORD_HASH_ALGORITHM="argon2"
AUTH_VERIFY_EMAIL_URL_BASE="http://127.0.0.1:7000/auth/verify-email"
AUTH_RESET_PASSWORD_URL_BASE="http://127.0.0.1:7000/auth/reset-password"
AUTH_OAUTH_STATE_COOKIE_NAME="secretwaifu_oauth_state"
AUTH_OAUTH_STATE_TTL_MS="600000"
AUTH_OAUTH_DEFAULT_REDIRECT_AFTER="/profile"
EMAIL_FROM="SecretWaifu <no-reply@secretwaifu.local>"
EMAIL_PROVIDER="smtp"
EMAIL_SMTP_HOST=""
EMAIL_SMTP_PORT="587"
EMAIL_SMTP_SECURE="false"
EMAIL_SMTP_USER=""
EMAIL_SMTP_PASS=""
MAILGUN_DOMAIN=""
MAILGUN_API_KEY=""
MAILGUN_REGION="us"
GOOGLE_OAUTH_ENABLED="false"
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://127.0.0.1:4000/api/auth/oauth/google/callback"
GOOGLE_OAUTH_SCOPES="openid email profile"
# Backend-only GA4 Measurement Protocol config for server-side purchase/revenue events.
# GOOGLE_ANALYTICS_MEASUREMENT_ID may match the frontend GA tag id; GOOGLE_ANALYTICS_API_SECRET must never be exposed client-side.
GOOGLE_ANALYTICS_MEASUREMENT_ID=""
GOOGLE_ANALYTICS_API_SECRET=""
GOOGLE_ANALYTICS_REVENUE_CURRENCY="USD"
# Use "eu" to send Measurement Protocol events to Google's EU collection endpoint.
GOOGLE_ANALYTICS_COLLECTION_REGION="global"
PATREON_OAUTH_ENABLED="false"
PATREON_CLIENT_ID=""
PATREON_CLIENT_SECRET=""
PATREON_REDIRECT_URI="http://127.0.0.1:4000/api/patreon/oauth/callback"
PATREON_SCOPES="identity identity.memberships campaigns"
PATREON_CAMPAIGN_ID=""
# Tier IDs from Patreon (comma-separated if multiple tiers should map to one internal tier).
PATREON_TIER_IDS_PREMIUM=""
PATREON_TIER_IDS_BASIC=""
# Optional fallback names (single ID):
PATREON_TIER_ID_PREMIUM=""
PATREON_TIER_ID_BASIC=""
# Legacy aliases still accepted during migration:
PATREON_TIER_IDS_SECRETWAIFU_ACCESS=""
PATREON_TIER_IDS_JUST_MODELS=""
PATREON_TIER_ID_SECRETWAIFU_ACCESS=""
PATREON_TIER_ID_JUST_MODELS=""
# Optional shared secret if you proxy Patreon webhook with a custom secret header.
PATREON_WEBHOOK_SHARED_SECRET=""
PATREON_TOKEN_ENCRYPTION_KEY=""
LEGACY_CODE_SECRET=""
LEGACY_VERIFY_CODE_OVERRIDES=""
ADMIN_TEST_BYPASS="false"
# Optional admin-only image generation proxy.
# IMAGE_GENERATION_API_BASE_URL="http://api2.squirclesystem.com/api/sdapi/v1"
# IMAGE_GENERATION_API_TOKEN=""
# Visible chat text generation provider. These credentials are backend-only;
# Unity never receives the upstream URL or bearer token.
CHAT_AI_PROVIDER_BASE_URL="https://api2.squirclesystem.com/api"
CHAT_AI_BEARER_TOKEN=""
CHAT_TTS_PROVIDER_WS_URL="wss://api2.squirclesystem.com/api/tts/ws"
CHAT_TTS_API_BEARER_TOKEN=""
# Enables request-scoped visible-chat prompt diagnostics when Unity sends debug_prompt=true.
# The full prompt contains player text/story/runtime context, but never provider credentials.
CHAT_PROMPT_DEBUG_ENABLED="false"
# When true, session + /auth/me treat every user as ADMIN (DB unchanged). Default is false — use DB roles; seed enforces sole admin email in seed.ts.
# FORCE_ALL_USERS_ADMIN="true"
